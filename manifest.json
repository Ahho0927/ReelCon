{
  "manifest_version": 3,
  "name": "Reel Controls",
  "version": "1.0.0",
  "description": "Instagram 릴과 홈 피드 영상에 자연스러운 홀드 제스처와 정밀 탐색 바를 추가합니다.",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Reel Controls",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    },
    "default_popup": "popup.html"
  }
}
